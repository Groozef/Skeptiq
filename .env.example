# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for news analysis
LLM_MODEL=claude-sonnet-4-6

# Telegram bot — create via @BotFather; chat_id via @userinfobot or getUpdates
TELEGRAM_BOT_TOKEN=
MY_TELEGRAM_CHAT_ID=

# IANA timezone for message timestamps (e.g. Asia/Almaty, Europe/Berlin, UTC)
MY_TIMEZONE=Asia/Almaty

# Comma-separated tickers, uppercase, no $, no exchange suffixes
WATCHLIST=BTC,ETH,SOL,LINK,AVAX,DOGE,XRP,ADA,DOT,MATIC,AAVE,UNI

# Recommendation filter thresholds
MIN_CONFIDENCE=0.6
MIN_IMPACT=medium

# RSS polling interval (seconds)
RSS_POLL_INTERVAL_SEC=60

# SQLite database (async)
DATABASE_URL=sqlite+aiosqlite:///./skeptiq.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Telegram message language: en or ru
MESSAGE_LANGUAGE=en
